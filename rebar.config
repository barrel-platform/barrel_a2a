{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% hex package is `erlang_h1' (the short name `h1' was taken);
    %% the OTP app/dep stays `h1' so call sites and the app graph
    %% use `h1' consistently.
    {h1, "~> 0.9.1", {pkg, erlang_h1}},
    {h2, "~> 0.12.0"},
    %% Client side. 4.4.5 or later: earlier releases mislabel a resumed
    %% HTTP/2 TLS session as HTTP/1 and spin.
    {hackney, "~> 4.7.4"}
]}.

{shell, [{apps, [barrel_a2a]}]}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_extra_apps, [ssl, public_key, crypto]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{profiles, [
    {test, [
        {deps, [{meck, "1.2.0"}, {proper, "1.5.0"}]}
    ]}
]}.

%% meck 1.2.0 still uses the bare `catch' operator, which OTP 29
%% deprecates; relax that one warning for the dep so it builds (our
%% own code uses try...catch). h1/h2/quic carry the same construct.
{overrides, [
    {add, meck, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, h1, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, h2, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "5.0.4"},
    rebar3_ex_doc
]}.

{erlfmt, [
    write,
    {files, [
        "{src,include,test}/**/*.{hrl,erl,app.src}",
        "examples/*/{src,test}/*.{erl,app.src}",
        "rebar.config"
    ]}
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"guides/getting-started.md", #{title => "Getting Started"}},
        {"guides/server.md", #{title => "Exposing an Agent"}},
        {"guides/client.md", #{title => "Talking to an Agent"}},
        {"guides/streaming.md", #{title => "Streaming"}},
        {"guides/task-lifecycle.md", #{title => "Task Lifecycle"}},
        {"guides/push-notifications.md", #{title => "Push Notifications"}},
        {"guides/authentication.md", #{title => "Authentication"}},
        {"guides/card-signing.md", #{title => "Agent Card Signing"}},
        {"guides/multi-tenancy.md", #{title => "Multi-tenancy"}},
        {"guides/extensions.md", #{title => "Extensions"}},
        {"guides/embedding.md", #{title => "Embedding"}},
        {"guides/testing.md", #{title => "Testing"}},
        {"docs/features.md", #{title => "Spec Coverage"}},
        {"docs/architecture.md", #{title => "Architecture"}},
        {"CHANGELOG.md", #{title => "Changelog"}},
        {"LICENSE", #{title => "License"}}
    ]},
    {main, "README.md"},
    {homepage_url, "https://github.com/barrel-platform/barrel_a2a"},
    {source_url, "https://github.com/barrel-platform/barrel_a2a"},
    {api_reference, true},
    {groups_for_modules, [
        {"Server", [
            barrel_a2a_server,
            barrel_a2a_ctx,
            barrel_a2a_handler,
            barrel_a2a_auth,
            barrel_a2a_http_engine,
            barrel_a2a_listener,
            barrel_a2a_server_core
        ]},
        {"Client", [
            barrel_a2a_client,
            barrel_a2a_remote_task,
            barrel_a2a_client_auth,
            barrel_a2a_client_transport,
            barrel_a2a_client_http,
            barrel_a2a_webhook
        ]},
        {"Protocol objects", [
            barrel_a2a_agent_card,
            barrel_a2a_message,
            barrel_a2a_part,
            barrel_a2a_artifact,
            barrel_a2a_task,
            barrel_a2a_task_state,
            barrel_a2a_event,
            barrel_a2a_error
        ]},
        {"Codec and validation", [
            barrel_a2a_json,
            barrel_a2a_jsonrpc,
            barrel_a2a_rest,
            barrel_a2a_sse,
            barrel_a2a_validate,
            barrel_a2a_schema,
            barrel_a2a_jsonschema,
            barrel_a2a_canonical,
            barrel_a2a_card_sign
        ]},
        {"Push notifications", [barrel_a2a_push, barrel_a2a_push_delivery]},
        {"Task storage", [
            barrel_a2a_task_store,
            barrel_a2a_task_store_ets,
            barrel_a2a_task_store_dets
        ]}
    ]}
]}.

{hex, [{doc, ex_doc}]}.

{elvis, [
    {config, [
        #{
            files => ["src/**/*.erl"],
            rules => [
                {elvis_style, no_macros, disable},
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, param_pattern_matching, disable},
                %% Map values decoded from JSON may be anything, so the
                %% explicit `=:= true' is the check, not a redundancy.
                {elvis_style, no_boolean_in_comparison, disable},
                %% `throw' carries protocol errors out of the option
                %% parser and the dispatcher pipeline to one catch site.
                {elvis_style, no_throw, #{
                    ignore => [barrel_a2a_server, barrel_a2a_server_core, barrel_a2a_client]
                }},
                %% simple_one_for_one start helper: the module is an
                %% argument by design.
                %% The DRY heuristic flags structurally similar but
                %% intentionally distinct wire branches; off project-wide.
                {elvis_style, dont_repeat_yourself, disable},
                %% The engine, core dispatcher, client and validator expose
                %% broad surfaces by design (one op per protocol method).
                {elvis_style, no_god_modules, #{
                    ignore => [
                        barrel_a2a_http_engine,
                        barrel_a2a_server_core,
                        barrel_a2a_client,
                        barrel_a2a_client_http,
                        barrel_a2a_validate,
                        barrel_a2a_jsonschema,
                        barrel_a2a_task_proc
                    ]
                }},
                %% Handlers, auth hooks and transports are dispatched
                %% dynamically by design.
                {elvis_style, no_invalid_dynamic_calls, #{
                    ignore => [
                        barrel_a2a_auth,
                        barrel_a2a_client,
                        barrel_a2a_client_sup,
                        barrel_a2a_client_transport,
                        barrel_a2a_listener,
                        barrel_a2a_task_proc,
                        barrel_a2a_server_core
                    ]
                }},
                %% Stream loops block on receive and end on a disconnect
                %% or a write failure; an after clause would be wrong.
                {elvis_style, no_receive_without_timeout, #{
                    ignore => [
                        barrel_a2a_http_engine,
                        barrel_a2a_listener,
                        barrel_a2a_client_http,
                        barrel_a2a_task_proc,
                        barrel_a2a_push_delivery
                    ]
                }},
                %% JSON Schema keyword atoms are the external wire shape.
                {elvis_style, atom_naming_convention, #{
                    ignore => [barrel_a2a_jsonschema, barrel_a2a_card_sign]
                }},
                %% Acceptor plumbing threads the per-stream handler fun.
                {elvis_style, no_deep_nesting, #{
                    ignore => [
                        barrel_a2a_listener,
                        barrel_a2a_jsonschema,
                        barrel_a2a_http_engine,
                        barrel_a2a_server_core
                    ]
                }},
                {elvis_style, max_anonymous_function_arity, #{
                    ignore => [barrel_a2a_listener]
                }},
                {elvis_text_style, max_line_length, #{
                    limit => 100,
                    skip_comments => whole_line
                }}
            ],
            ruleset => erl_files
        },
        #{
            files => ["rebar.config"],
            rules => [
                {elvis_project, no_branch_deps, disable}
            ],
            ruleset => rebar_config
        }
    ]}
]}.
