%% Standalone build configuration for the echo_client example.
%%
%% Inside this repository, the build picks up `barrel_a2a' via
%% `_checkouts/barrel_a2a', a symlink back to the parent directory
%% created by `make examples-setup' (or by hand:
%% `mkdir -p _checkouts && ln -s ../../.. _checkouts/barrel_a2a').
%%
%% Outside the repository, replace the dep below with a hex coordinate
%% such as `{barrel_a2a, "0.1.0"}'.

{erl_opts, [debug_info, warnings_as_errors]}.
%% The client example also runs the sibling server example in its
%% test and `run/0'; `make examples-setup' links it into _checkouts too.
{deps, [
    %% rebar3 does not resolve a renamed package dep (`{pkg, erlang_h1}')
    %% of a checkout app, so `h1' is declared here too; keep the
    %% version in step with barrel_a2a's rebar.config.
    {h1, "~> 0.9.1", {pkg, erlang_h1}},
    {barrel_a2a, {git, "https://github.com/barrel-platform/barrel_a2a.git", {branch, "main"}}},
    {echo_server, {git, "https://github.com/barrel-platform/barrel_a2a.git", {branch, "main"}}}
]}.
{shell, [{apps, [barrel_a2a, echo_server, echo_client]}]}.
{eunit_opts, [verbose]}.
